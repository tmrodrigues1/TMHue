<Window x:Class="TMHue.App.Views.MagnifierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Focusable="False"
        ShowActivated="False"
        SizeToContent="WidthAndHeight">
    <Border BorderBrush="#FF4A4E72" BorderThickness="1" CornerRadius="10" Padding="8">
        <!-- Opaque take on the dark popover glass: the lens must never tint what it magnifies. -->
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF20233A" Offset="0" />
                <GradientStop Color="#FF161726" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <StackPanel>
            <TextBlock Text="{DynamicResource L.Magnifier.EscHint}" Foreground="#FFA6A9C6" FontFamily="Segoe UI"
                       FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,0" />
            <TextBlock Text="{DynamicResource L.Magnifier.ArrowsHint}" Foreground="#FFA6A9C6" FontFamily="Segoe UI"
                       FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,8" />
            <Grid Width="132" Height="132">
                <Border ClipToBounds="True" CornerRadius="4">
                    <!-- NearestNeighbor keeps each source pixel as a crisp 12x12 block instead of
                         a blurred bilinear smear, which is the whole point of the lens. -->
                    <Image x:Name="PixelImage" Width="132" Height="132"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           SnapsToDevicePixels="True" />
                </Border>
                <!-- 12 DIP per cell; outline the configured 1/5/11-pixel sampling area. -->
                <Border x:Name="SampleOutline" Width="12" Height="12" BorderBrush="Black" BorderThickness="3"
                        HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                <Border x:Name="SampleBoundary" Width="12" Height="12" BorderBrush="White" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                <Border Width="12" Height="12" BorderBrush="#FFEACC48" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
            <TextBlock x:Name="SampleLabel" Foreground="#FFA6A9C6" FontSize="11"
                       HorizontalAlignment="Center" Margin="0,6,0,0" />
            <TextBlock x:Name="SourceLabel" Foreground="#FFA6A9C6" FontSize="10" MaxWidth="240"
                       TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,4,0,0" />
            <TextBlock x:Name="HexLabel" Text="#000000" Foreground="White" FontFamily="Consolas"
                       FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0" />
            <TextBlock x:Name="FormatHint" FontFamily="Segoe UI" FontSize="10"
                       HorizontalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>
    </Border>
</Window>
