<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light counterpart of the dark glass: a clean white pane with no colored blooms (they read
         as stains on white). It is only slightly see-through: the windows are layered with no
         backdrop blur, so any more would show whatever sits behind them in sharp focus. The
         bottom settles into a neutral off-white so the white cards still lift off the pane. -->
    <LinearGradientBrush x:Key="Brush.Surface" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F2FFFFFF" Offset="0" />
        <GradientStop Color="#F2F7F7F9" Offset="1" />
    </LinearGradientBrush>

    <!-- A white rim would vanish against a light desktop, so the light rim is a cool hairline. -->
    <LinearGradientBrush x:Key="Brush.WindowBorder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#291B1B45" Offset="0" />
        <GradientStop Color="#1A1B1B45" Offset="0.5" />
        <GradientStop Color="#331B1B45" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.SurfaceElevated" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#C7FFFFFF" Offset="0" />
        <GradientStop Color="#94FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.SurfaceSunken" Color="#0F1B1B45" />
    <SolidColorBrush x:Key="Brush.Border" Color="#1F1B1B45" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#381B1B45" />

    <SolidColorBrush x:Key="Brush.HoverFill" Color="#141B1B45" />
    <SolidColorBrush x:Key="Brush.PressedFill" Color="#211B1B45" />

    <LinearGradientBrush x:Key="Brush.Popover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFFFF" Offset="0" />
        <GradientStop Color="#FFF6F6FB" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.PopoverBorder" Color="#2E1B1B45" />

    <LinearGradientBrush x:Key="Brush.GlassAccent" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1F6A4BE0" Offset="0" />
        <GradientStop Color="#146A4BE0" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.GlassAccentHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#336A4BE0" Offset="0" />
        <GradientStop Color="#246A4BE0" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.GlassAccentPressed" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#426A4BE0" Offset="0" />
        <GradientStop Color="#336A4BE0" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.GlassAccentBorder" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#386A4BE0" Offset="0" />
        <GradientStop Color="#526A4BE0" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Brush.SwatchRim" Color="#24000000" />

    <!-- WCAG: on the white/near-white surfaces, TextPrimary ≈ 15.9:1, TextSecondary ≈ 5.7:1 and
         TextTertiary ≈ 4.8:1 — all above the 4.5:1 AA minimum for normal text. The old alphas
         (8A/54) flattened to ≈3.9:1 and ≈2.3:1 and failed AA. -->
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#FF16161A" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#A616161A" />
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="#9916161A" />

    <SolidColorBrush x:Key="Brush.Accent" Color="#FF2F6FED" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#FF2760D0" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#FF1F52B8" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#182F6FED" />
    <SolidColorBrush x:Key="Brush.HotkeyText" Color="#FF6A4BE0" />
    <LinearGradientBrush x:Key="Brush.AccentGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF2F6FED" Offset="0" />
        <GradientStop Color="#FF6A4BE0" Offset="1" />
    </LinearGradientBrush>

    <!-- Tool tiles on light: frosted white slabs with dark text (white text would vanish on
         this fill). Hover brightens to solid white; pressed sinks back into the pane. -->
    <LinearGradientBrush x:Key="Brush.CaptureGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E6FFFFFF" Offset="0" />
        <GradientStop Color="#B3FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.CaptureGradientHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFFFF" Offset="0" />
        <GradientStop Color="#EBFFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.CaptureGradientPressed" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E6ECECF5" Offset="0" />
        <GradientStop Color="#E6E4E4F0" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.CaptureButtonText" Color="#FF16161A" />
    <LinearGradientBrush x:Key="Brush.CaptureButtonBorder" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1F1B1B45" Offset="0" />
        <GradientStop Color="#331B1B45" Offset="1" />
    </LinearGradientBrush>

    <!-- Feedback colors, AA-compliant on the light surfaces (error ≈ 5.6:1, success ≈ 5.0:1). -->
    <SolidColorBrush x:Key="Brush.Error" Color="#FFC42B2B" />
    <SolidColorBrush x:Key="Brush.Success" Color="#FF1B7F4D" />

    <SolidColorBrush x:Key="Brush.OverlayScrim" Color="#59000000" />
    <SolidColorBrush x:Key="Brush.PreviewSurface" Color="#F5222226" />
    <SolidColorBrush x:Key="Brush.PreviewText" Color="#FFF5F5F7" />

    <DropShadowEffect x:Key="Shadow.Window" Color="#1B1B45" Opacity="0.22" BlurRadius="28" ShadowDepth="6" Direction="270" />
    <DropShadowEffect x:Key="Shadow.Card" Color="#1B1B45" Opacity="0.14" BlurRadius="16" ShadowDepth="4" Direction="270" />
    <DropShadowEffect x:Key="Shadow.Preview" Color="#000000" Opacity="0.35" BlurRadius="22" ShadowDepth="8" Direction="270" />

</ResourceDictionary>
